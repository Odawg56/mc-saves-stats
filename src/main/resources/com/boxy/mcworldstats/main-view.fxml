<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.boxy.mcworldstats.MainController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <TextArea fx:id="outputBox" editable="false" prefHeight="200.0" prefWidth="200.0" promptText="Output goes here" />
   <HBox prefHeight="100.0" prefWidth="200.0">
      <children>
         <Button fx:id="directoryButton" mnemonicParsing="false" onAction="#onDirectoryButtonClick" text="Select Directory..." />
          <Button fx:id="generateButton" onAction="#onGenerateButtonClick" text="Generate" />
      </children>
   </HBox>
   <TextField fx:id="directoryField" editable="false" promptText="directory" />
</VBox>

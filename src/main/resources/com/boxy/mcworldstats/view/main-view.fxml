<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="480.0" prefWidth="720.0" spacing="20.0" styleClass="bg" stylesheets="@css/main.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.boxy.mcworldstats.controller.MainController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <AnchorPane prefHeight="20.0" prefWidth="680.0">
      <children>
         <HBox prefHeight="27.0" prefWidth="470.0" spacing="5.0">
            <children>
               <Button fx:id="directoryButton" mnemonicParsing="false" onAction="#onDirectoryButtonClick" text="Select Directory..." />
               <TextField fx:id="directoryField" editable="false" prefHeight="26.0" prefWidth="260.0" promptText="Directory" HBox.hgrow="ALWAYS" />
            </children>
         </HBox>
          <Button fx:id="generateButton" onAction="#onGenerateButtonClick" text="Generate" AnchorPane.rightAnchor="0.0" />
      </children>
   </AnchorPane>
   <GridPane>
     <columnConstraints>
       <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
       <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
     </columnConstraints>
     <rowConstraints>
       <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
       <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
       <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
     </rowConstraints>
      <children>
         <CheckBox mnemonicParsing="false" text="CheckBox" />
         <CheckBox mnemonicParsing="false" text="CheckBox" GridPane.rowIndex="1" />
         <CheckBox mnemonicParsing="false" text="CheckBox" GridPane.rowIndex="2" />
         <CheckBox mnemonicParsing="false" text="CheckBox" GridPane.columnIndex="1" />
         <CheckBox mnemonicParsing="false" text="CheckBox" GridPane.columnIndex="1" GridPane.rowIndex="1" />
         <CheckBox mnemonicParsing="false" text="CheckBox" GridPane.columnIndex="1" GridPane.rowIndex="2" />
      </children>
   </GridPane>
   <TabPane prefHeight="200.0" prefWidth="200.0" styleClass="bg" tabClosingPolicy="UNAVAILABLE">
     <tabs>
       <Tab text="Directory Stats">
         <content>
           <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" />
         </content>
       </Tab>
       <Tab text="World Stats">
         <content>
           <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" style="-fx-background-color: red;" />
         </content>
       </Tab>
         <Tab text="Player Stats">
             <content>
                 <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" />
             </content>
         </Tab>
     </tabs>
   </TabPane>
</VBox>
